{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": ["http://localhost/pt/index.html", "http://localhost/en/index.html"],
      "numberOfRuns": 1
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.95 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }]
      }
    }
  }
}
