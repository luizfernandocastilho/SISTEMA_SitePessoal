# Segredos do Umami (self-hosted). Copie para `.env` e preencha com valores fortes.
# O `.env` real NÃO é versionado (ver .gitignore). Gere valores com, ex.:
#   openssl rand -hex 32
UMAMI_APP_SECRET=troque-por-uma-string-aleatoria-longa
UMAMI_DB_PASSWORD=troque-por-uma-senha-forte

# Opcionais (têm default no docker-compose.yml):
# POSTGRES_DB=umami
# POSTGRES_USER=umami
