{
  "name": "site-download-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API de gate de download por e-mail (captura de leads em Postgres) para o site pessoal.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "migrate": "tsx src/migrate.ts",
    "seed": "tsx src/seed.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/formbody": "^7.4.0",
    "@fastify/rate-limit": "^9.1.0",
    "fastify": "^4.28.1",
    "nodemailer": "^6.9.14",
    "pg": "^8.12.0",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/nodemailer": "^6.4.15",
    "@types/pg": "^8.11.6",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
