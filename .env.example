# URL e base do site (usadas em astro.config.mjs para sitemap/links absolutos)
SITE_URL=https://www.luizcastilho.com
BASE_PATH=/

# URL pública do backend de download-gate (api/). Embutida no build (prefixo PUBLIC_)
# como `action` do formulário de solicitação. Aponte para a API publicada no NAS.
PUBLIC_API_URL=https://api.luizcastilho.com

# Analytics Umami (self-hosted no NAS). O snippet só é injetado no build quando AMBAS
# estão definidas; ausentes (ex.: dev/preview) = sem tracking. Prefixo PUBLIC_ = embutido
# no build. PUBLIC_UMAMI_SRC é a URL do script; PUBLIC_UMAMI_WEBSITE_ID é o id do site
# criado no painel Umami.
PUBLIC_UMAMI_SRC=https://analytics.luizcastilho.com/script.js
PUBLIC_UMAMI_WEBSITE_ID=00000000-0000-0000-0000-000000000000
