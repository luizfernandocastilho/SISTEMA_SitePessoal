# Chave da YouTube Data API v3 (usada apenas em build; nunca enviada ao navegador)
YOUTUBE_API_KEY=

# ID do canal do YouTube (formato UC...). Alternativamente resolva a partir do handle.
CHANNEL_ID=

# Quantidade de vídeos a exibir (default: 6)
MAX_VIDEOS=6

# URL e base do site (usadas em astro.config.mjs para sitemap/links absolutos)
SITE_URL=https://luizfernandocastilho.github.io
BASE_PATH=/SISTEMA_SitePessoal
