# URL e base do site (usadas em astro.config.mjs para sitemap/links absolutos)
SITE_URL=https://www.luizcastilho.com
BASE_PATH=/

# URL pública do backend de download-gate (api/). Embutida no build (prefixo PUBLIC_)
# como `action` do formulário de solicitação. Aponte para a API publicada no NAS.
PUBLIC_API_URL=https://api.luizcastilho.com
