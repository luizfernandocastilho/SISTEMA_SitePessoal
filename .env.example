# URL e base do site (usadas em astro.config.mjs para sitemap/links absolutos)
SITE_URL=https://www.luizcastilho.com
BASE_PATH=/

# URL pública da API de download-gate (backend em api/). O formulário de download
# faz POST para ${PUBLIC_API_URL}/downloads/request. Ajuste para a API publicada no NAS.
PUBLIC_API_URL=https://api.luizcastilho.com
