    )
  }
  {
    name === 'bluesky' && (
      <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
        <path d="M5.77 3.03c2.53 1.9 5.25 5.75 6.23 7.82.98-2.07 3.7-5.92 6.23-7.82 1.83-1.37 4.79-2.43 4.79.95 0 .67-.39 5.66-.61 6.47-.79 2.82-3.66 3.54-6.22 3.1 4.47.77 5.61 3.29 3.15 5.81-4.67 4.79-6.71-1.2-7.24-2.73-.1-.28-.14-.41-.14-.3 0-.11-.05.02-.14.3-.53 1.53-2.57 7.52-7.24 2.73-2.46-2.52-1.32-5.04 3.15-5.81-2.56.44-5.43-.28-6.22-3.1C.71 9.64.32 4.65.32 3.98c0-3.38 2.96-2.32 4.79-.95Z" />
      </svg>
    )
  }
  {
    name === 'x' && (
      <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
        <path d="M18.9 1.15h3.68l-8.04 9.19L24 22.85h-7.41l-5.8-7.58-6.64 7.58H.46l8.6-9.83L0 1.15h7.6l5.24 6.93 6.06-6.93Zm-1.29 19.5h2.04L6.48 3.24H4.3l13.31 17.41Z" />
