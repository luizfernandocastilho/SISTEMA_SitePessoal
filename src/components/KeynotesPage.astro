---
import BaseLayout from '../layouts/BaseLayout.astro';
import Keynotes from './Keynotes.astro';
import { getUi, getProfile, getKeynotes } from '../lib/content';
import { t, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { strings, fallback } = await getUi(locale);
const profile = await getProfile();
const keynotes = await getKeynotes();

const section = t(strings, 'sectionKeynotes', fallback);
const title = `${section} · ${profile?.name ?? 'Site Pessoal'}`;
---

<BaseLayout
  locale={locale}
  title={title}
  description={section}
  strings={strings}
  fallback={fallback}
  navKey="keynotes"
>
  <Keynotes id="keynotes" locale={locale} items={keynotes} strings={strings} fallback={fallback} />
</BaseLayout>
