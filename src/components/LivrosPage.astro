---
import BaseLayout from '../layouts/BaseLayout.astro';
import Livros from './Livros.astro';
import { getUi, getProfile, getLivros } from '../lib/content';
import { NAV_ITEMS, NAV_CHILDREN, navChildUrl } from '../lib/nav';
import { t, otherLocale, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { strings, fallback } = await getUi(locale);
const profile = await getProfile();
const livros = await getLivros();

const section = t(strings, 'sectionLivros', fallback);
const title = `${section} · ${profile?.name ?? 'Site Pessoal'}`;

// Sub-página de Publicações → o toggle de idioma preserva a página de Livros.
const parent = NAV_ITEMS.find((i) => i.key === 'publications')!;
const child = NAV_CHILDREN['publications'].find((c) => c.key === 'livros')!;
const counterpartHref = navChildUrl(parent, child, otherLocale(locale));
---

<BaseLayout
  locale={locale}
  title={title}
  description={section}
  strings={strings}
  fallback={fallback}
  navKey="publications"
  counterpartHref={counterpartHref}
>
  <Livros id="livros" locale={locale} items={livros} strings={strings} fallback={fallback} />
</BaseLayout>
