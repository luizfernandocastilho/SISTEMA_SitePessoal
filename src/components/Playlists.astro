---
import { thumbnailUrl } from '../lib/youtube-urls';
import { t, type Locale } from '../lib/i18n';

interface Playlist {
  title_pt: string;
  title_en: string;
  url: string;
  coverVideoId: string;
  order?: number;
}

interface Props {
  id: string;
  locale: Locale;
  items: Playlist[];
  strings: Record<string, string>;
  fallback: Record<string, string>;
}

const { id, locale, items, strings, fallback } = Astro.props;
---

<section class="section" id={id} aria-labelledby={`${id}-title`}>
  <div class="container">
    <h2 id={`${id}-title`}>{t(strings, 'sectionVideos', fallback)}</h2>
    <ul class="playlist-grid">
      {
        items.map((p) => {
          const title = locale === 'pt' ? p.title_pt : p.title_en;
          return (
            <li class="playlist-card">
              <a href={p.url} target="_blank" rel="noopener noreferrer">
                <span class="playlist-cover">
                  <img
                    src={thumbnailUrl(p.coverVideoId)}
                    alt={title}
                    loading="lazy"
                    width="480"
                    height="360"
                  />
                  <span class="playlist-badge">▶ {t(strings, 'playlistView', fallback)}</span>
                </span>
                <span class="playlist-title">{title}</span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  .playlist-grid {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.25rem;
  }
  .playlist-card a {
    display: block;
    text-decoration: none;
    color: var(--color-text);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--color-surface);
  }
  .playlist-card a:hover {
    border-color: var(--color-accent);
  }
  .playlist-cover {
    position: relative;
    display: block;
  }
  .playlist-cover img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    background: var(--color-border);
  }
  .playlist-badge {
    position: absolute;
    bottom: 0.6rem;
    right: 0.6rem;
    background: var(--color-accent);
    color: var(--color-accent-contrast);
    font-size: 0.8rem;
    font-weight: 600;
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius);
  }
  .playlist-title {
    display: block;
    padding: 0.75rem 0.9rem;
    font-weight: 600;
    line-height: 1.35;
  }
</style>
