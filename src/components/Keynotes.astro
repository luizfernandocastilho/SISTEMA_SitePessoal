---
import { withBase } from '../lib/paths';
import { t, type Locale } from '../lib/i18n';

interface Keynote {
  title_pt: string;
  title_en: string;
  url?: string;
  pdf?: string;
  cover?: string;
  date?: Date;
  order?: number;
}

interface Props {
  id: string;
  locale: Locale;
  items: Keynote[];
  strings: Record<string, string>;
  fallback: Record<string, string>;
}

const { id, locale, items, strings, fallback } = Astro.props;
const base = import.meta.env.BASE_URL;
const dateFmt = new Intl.DateTimeFormat(locale === 'pt' ? 'pt-BR' : 'en-US', {
  year: 'numeric',
  month: 'long',
});
---

<section class="section" id={id} aria-labelledby={`${id}-title`}>
  <div class="container">
    <h2 id={`${id}-title`}>{t(strings, 'sectionKeynotes', fallback)}</h2>
    <ul class="keynote-grid">
      {
        items.map((k) => {
          const title = locale === 'pt' ? k.title_pt : k.title_en;
          const href = k.pdf ? withBase(k.pdf, base) : k.url!;
          const cover = k.cover
            ? k.cover.startsWith('http')
              ? k.cover
              : withBase(k.cover, base)
            : null;
          return (
            <li class="keynote-card">
              <a href={href} target="_blank" rel="noopener noreferrer">
                <span class="keynote-cover">
                  {cover ? (
                    <img src={cover} alt={title} loading="lazy" width="480" height="270" />
                  ) : (
                    <span class="keynote-slide">
                      <span class="keynote-slide-label">Keynote</span>
                      <span class="keynote-slide-title">{title}</span>
                    </span>
                  )}
                </span>
                <span class="keynote-body">
                  <span class="keynote-title">{title}</span>
                  {k.date && <span class="keynote-date">{dateFmt.format(k.date)}</span>}
                  <span class="keynote-action">{t(strings, 'keynoteView', fallback)} →</span>
                </span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  .keynote-grid {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.25rem;
  }
  .keynote-card a {
    display: block;
    text-decoration: none;
    color: var(--color-text);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    overflow: hidden;
  }
  .keynote-card a:hover {
    border-color: var(--color-accent);
  }
  .keynote-cover {
    display: block;
    aspect-ratio: 16 / 9;
  }
  .keynote-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Painel estilo slide (quando não há capa): fundo verde, tipografia Oswald reversa. */
  .keynote-slide {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0.35rem;
    width: 100%;
    height: 100%;
    padding: 1rem 1.1rem;
    background: var(--color-accent);
    color: var(--color-accent-contrast);
    border-top: 3px solid var(--color-accent-vivid, #4fb055);
  }
  .keynote-slide-label {
    font-family: var(--font-display);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--ls-label, 0.14em);
    font-size: 0.72rem;
    opacity: 0.85;
  }
  .keynote-slide-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.25rem;
    line-height: 1.15;
  }
  .keynote-body {
    display: block;
    padding: 0.85rem 1rem 1rem;
  }
  .keynote-title {
    display: block;
    font-weight: 600;
    line-height: 1.35;
  }
  .keynote-date {
    display: block;
    margin-top: 0.15rem;
    color: var(--color-muted);
    font-size: 0.9rem;
  }
  .keynote-action {
    display: block;
    margin-top: 0.5rem;
    color: var(--color-accent);
    font-weight: 600;
    font-size: 0.95rem;
  }
</style>
