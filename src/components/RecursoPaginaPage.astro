---
import BaseLayout from '../layouts/BaseLayout.astro';
import Relatorios from './Relatorios.astro';
import { getUi, getProfile, getRelatorios } from '../lib/content';
import { NAV_ITEMS, NAV_CHILDREN, navUrl, navChildUrl } from '../lib/nav';
import { t, otherLocale, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
  childKey: string;
}

const { locale, childKey } = Astro.props;
const { strings, fallback } = await getUi(locale);
const profile = await getProfile();

// Decks do subitem "Análises e Relatórios" (coleção `relatorios`).
const relatorios = childKey === 'analises' ? await getRelatorios() : [];

const parent = NAV_ITEMS.find((i) => i.key === 'resources')!;
const child = NAV_CHILDREN['resources'].find((c) => c.key === childKey)!;

const title = t(strings, child.labelKey, fallback);
const sectionLabel = t(strings, 'sectionResources', fallback);
const pageTitle = `${title} · ${profile?.name ?? 'Site Pessoal'}`;
const gridUrl = navUrl(parent, locale);
const counterpartHref = navChildUrl(parent, child, otherLocale(locale));
---

<BaseLayout
  locale={locale}
  title={pageTitle}
  description={title}
  strings={strings}
  fallback={fallback}
  navKey="resources"
  counterpartHref={counterpartHref}
>
  <section class="section">
    <div class="container page">
      <p class="section-label">{sectionLabel}</p>
      <h1>{title}</h1>
      {
        relatorios.length > 0 ? (
          <Relatorios locale={locale} items={relatorios} strings={strings} fallback={fallback} />
        ) : (
          <p class="page-soon">{t(strings, 'pageContentSoon', fallback)}</p>
        )
      }
      <p class="page-back">
        <a href={gridUrl}>← {t(strings, 'resourcesBack', fallback)}</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .page {
    max-width: 48rem;
  }
  .page-soon {
    margin-top: 1.5rem;
    color: var(--color-muted);
  }
  .page-back {
    margin-top: 2.5rem;
  }
  .page-back a {
    color: var(--color-muted);
    text-decoration: none;
    font-weight: 600;
  }
  .page-back a:hover {
    color: var(--color-text);
  }
</style>
