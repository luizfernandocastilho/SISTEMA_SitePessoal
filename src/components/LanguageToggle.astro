---
import type { Locale } from '../lib/i18n';
import { otherLocale, t } from '../lib/i18n';
import { counterpartUrl, atuacaoAreaUrl } from '../lib/nav';

interface Props {
  locale: Locale;
  strings: Record<string, string>;
  fallback: Record<string, string>;
  navKey: string;
  atuacaoSlug?: string;
}

const { locale, strings, fallback, navKey, atuacaoSlug } = Astro.props;
const target = otherLocale(locale);
// Link para a MESMA página no outro idioma (preserva a página). Sem JS.
// Em páginas de área de Atuação, preserva a área específica pelo slug.
const href = atuacaoSlug ? atuacaoAreaUrl(target, atuacaoSlug) : counterpartUrl(navKey, target);
---

<a class="lang-toggle" href={href} hreflang={target}>
  <span class="visually-hidden">{t(strings, 'langToggleLabel', fallback)}: </span>{
    t(strings, 'langSwitchTo', fallback)
  }
</a>

<style>
  .lang-toggle {
    display: inline-block;
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    text-decoration: none;
    font-size: 0.9rem;
    color: var(--color-text);
    white-space: nowrap;
  }
  .lang-toggle:hover {
    background: var(--color-surface);
  }
</style>
