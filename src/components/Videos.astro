---
import { t, type Locale } from '../lib/i18n';
import type { Video } from '../lib/youtube';

interface Props {
  id: string;
  locale: Locale;
  videos: Video[];
  channelUrl?: string;
  strings: Record<string, string>;
  fallback: Record<string, string>;
}

const { id, videos, channelUrl, strings, fallback } = Astro.props;
---

<section class="section" id={id} aria-labelledby={`${id}-title`}>
  <div class="container">
    <div class="videos-head">
      <h2 id={`${id}-title`}>{t(strings, 'sectionVideos', fallback)}</h2>
      {
        channelUrl && (
          <a href={channelUrl} target="_blank" rel="noopener noreferrer">
            {t(strings, 'videosVisitChannel', fallback)}
          </a>
        )
      }
    </div>
    <ul class="video-grid">
      {
        videos.map((v) => (
          <li class="video-card">
            <a href={v.url} target="_blank" rel="noopener noreferrer">
              {v.thumbnail ? (
                <img src={v.thumbnail} alt={v.title} loading="lazy" width="320" height="180" />
              ) : (
                <div class="video-thumb-fallback" aria-hidden="true" />
              )}
              <span class="video-title">{v.title}</span>
              <span class="visually-hidden">— {t(strings, 'videoWatch', fallback)}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .videos-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .video-grid {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.25rem;
  }
  .video-card a {
    display: block;
    text-decoration: none;
    color: var(--color-text);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--color-surface);
  }
  .video-card a:hover {
    border-color: var(--color-accent);
  }
  .video-card img,
  .video-thumb-fallback {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    background: var(--color-border);
  }
  .video-title {
    display: block;
    padding: 0.7rem 0.85rem;
    font-weight: 600;
    font-size: 0.95rem;
    line-height: 1.35;
  }
</style>
