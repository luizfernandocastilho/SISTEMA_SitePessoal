---
import { withBase } from '../lib/paths';
import { t, type Locale } from '../lib/i18n';

interface Relatorio {
  title: string;
  description_pt?: string;
  description_en?: string;
  pdf: string;
  cover?: string;
  date?: Date;
  order?: number;
}

interface Props {
  locale: Locale;
  items: Relatorio[];
  strings: Record<string, string>;
  fallback: Record<string, string>;
}

const { locale, items, strings, fallback } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<ul class="relatorio-grid">
  {
    items.map((r) => {
      const description = locale === 'pt' ? r.description_pt : r.description_en;
      const href = withBase(r.pdf, base);
      const cover = r.cover
        ? r.cover.startsWith('http')
          ? r.cover
          : withBase(r.cover, base)
        : null;
      return (
        <li class="relatorio-card">
          <a href={href} download target="_blank" rel="noopener noreferrer">
            <span class="relatorio-cover">
              {cover ? (
                <img
                  class="relatorio-cover-img"
                  src={cover}
                  alt={r.title}
                  loading="lazy"
                  width="1000"
                  height="1415"
                />
              ) : (
                <span class="relatorio-slide">
                  <span class="relatorio-slide-title">{r.title}</span>
                </span>
              )}
            </span>
            <span class="relatorio-body">
              {cover && <span class="relatorio-title">{r.title}</span>}
              {description && <span class="relatorio-desc">{description}</span>}
              <span class="relatorio-action">{t(strings, 'articleDownload', fallback)} →</span>
            </span>
          </a>
        </li>
      );
    })
  }
</ul>

<style>
  .relatorio-grid {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.25rem;
  }
  .relatorio-card a {
    display: block;
    text-decoration: none;
    color: var(--color-text);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    overflow: hidden;
    height: 100%;
  }
  .relatorio-card a:hover {
    border-color: var(--color-accent);
  }
  .relatorio-cover {
    display: block;
    aspect-ratio: 16 / 9;
  }
  .relatorio-cover-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Enquadra o bloco do título/subtítulo da capa (evita cortar o topo do título). */
    object-position: center 42%;
  }
  /* Painel estilo slide (sem capa): fundo verde, tipografia Oswald reversa. */
  .relatorio-slide {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    width: 100%;
    height: 100%;
    padding: 1rem 1.1rem;
    background: var(--color-accent);
    color: var(--color-accent-contrast);
    border-top: 3px solid var(--color-accent-vivid, #4fb055);
  }
  .relatorio-slide-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.25rem;
    line-height: 1.15;
  }
  .relatorio-body {
    display: block;
    padding: 0.85rem 1rem 1rem;
  }
  .relatorio-title {
    display: block;
    font-weight: 600;
    line-height: 1.35;
  }
  .relatorio-desc {
    display: block;
    margin-top: 0.35rem;
    color: var(--color-muted);
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .relatorio-action {
    display: block;
    margin-top: 0.5rem;
    color: var(--color-accent);
    font-weight: 600;
    font-size: 0.95rem;
  }
</style>
