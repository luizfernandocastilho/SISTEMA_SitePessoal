---
import { t, type Locale } from '../lib/i18n';
import { groupCertificationsByIssuer } from '../lib/certifications';

interface Certification {
  name: string;
  issuer: string;
  year: number;
  verifyUrl?: string;
  order?: number;
}

interface Props {
  id: string;
  locale: Locale;
  items: Certification[];
  strings: Record<string, string>;
  fallback: Record<string, string>;
}

const { id, items, strings, fallback } = Astro.props;
// Consolida as certificações por instituição: cada grupo é um <details> nativo
// (acordeão sem JS) que expande ao clicar. Ver src/lib/certifications.ts.
const groups = groupCertificationsByIssuer(items);
const verifyLabel = t(strings, 'certVerify', fallback);
---

<section class="section" id={id} aria-labelledby={`${id}-title`}>
  <div class="container">
    <h2 id={`${id}-title`}>{t(strings, 'sectionCertifications', fallback)}</h2>
    <div class="cert-groups">
      {
        groups.map((g) => (
          <details class="cert-group">
            <summary class="cert-group-summary">
              <span class="cert-group-issuer">{g.issuer}</span>
              <span class="cert-group-count">{g.items.length}</span>
              <svg
                class="cert-group-chevron"
                width="16"
                height="16"
                viewBox="0 0 16 16"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <polyline points="4 6 8 10 12 6" />
              </svg>
            </summary>
            <ul class="cert-list">
              {g.items.map((c) => (
                <li class="cert-item">
                  <div>
                    <p class="cert-name">{c.name}</p>
                    <p class="cert-meta">{c.year}</p>
                  </div>
                  {c.verifyUrl && (
                    <a
                      class="cert-verify"
                      href={c.verifyUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {verifyLabel}
                    </a>
                  )}
                </li>
              ))}
            </ul>
          </details>
        ))
      }

      {
        /*
        Medidor invisível: replica os grupos JÁ ABERTOS para fixar a largura do
        acordeão na maior linha (cabeçalho ou nome de certificação + link), mesmo
        com os <details> recolhidos (que usam display:none no conteúdo). Não é
        pintado nem lido por leitores de tela (height:0 + visibility:hidden +
        aria-hidden), mas contribui para o `max-content` do container. Ver #78.
      */
      }
      <div class="cert-groups-sizer" aria-hidden="true">
        {
          groups.map((g) => (
            <div class="cert-group">
              <div class="cert-group-summary">
                <span class="cert-group-issuer">{g.issuer}</span>
                <span class="cert-group-count">{g.items.length}</span>
                <svg
                  class="cert-group-chevron"
                  width="16"
                  height="16"
                  viewBox="0 0 16 16"
                  aria-hidden="true"
                >
                  <polyline points="4 6 8 10 12 6" />
                </svg>
              </div>
              <ul class="cert-list">
                {g.items.map((c) => (
                  <li class="cert-item">
                    <div>
                      <p class="cert-name">{c.name}</p>
                      <p class="cert-meta">{c.year}</p>
                    </div>
                    {c.verifyUrl && <span class="cert-verify">{verifyLabel}</span>}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  /* Largura mínima e uniforme: o container encolhe para a maior linha do seu
     conteúdo (max-content) sem estourar o .container; todos os grupos herdam
     essa largura via width:100%. Alinhado à esquerda. Ver #78. */
  .cert-groups {
    display: grid;
    justify-items: start;
    width: max-content;
    max-width: 100%;
    gap: 0.75rem;
    margin: 1.5rem 0 0;
  }
  .cert-group {
    width: 100%;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }
  .cert-group-summary {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    cursor: pointer;
    font-weight: 600;
    list-style: none;
    white-space: nowrap;
  }
  /* Remove o marcador nativo do <summary> (usamos o chevron abaixo). */
  .cert-group-summary::-webkit-details-marker {
    display: none;
  }
  .cert-group-summary::marker {
    content: '';
  }
  .cert-group-summary:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  .cert-group-issuer {
    flex: 1;
  }
  .cert-group-count {
    flex-shrink: 0;
    min-width: 1.5rem;
    padding: 0.1rem 0.5rem;
    text-align: center;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-muted);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 999px;
  }
  .cert-group-chevron {
    flex-shrink: 0;
    color: var(--color-muted);
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.2s ease;
  }
  .cert-group[open] .cert-group-chevron {
    transform: rotate(180deg);
  }
  @media (prefers-reduced-motion: reduce) {
    .cert-group-chevron {
      transition: none;
    }
  }
  .cert-list {
    list-style: none;
    margin: 0;
    padding: 0 1.25rem 0.5rem;
    display: grid;
  }
  .cert-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: nowrap;
    padding: 0.75rem 0;
    border-top: 1px solid var(--color-border);
  }
  .cert-name {
    font-weight: 600;
    margin: 0;
    white-space: nowrap;
  }
  .cert-meta {
    margin: 0.15rem 0 0;
    color: var(--color-muted);
    font-size: 0.95rem;
  }
  .cert-verify {
    white-space: nowrap;
    font-weight: 600;
  }

  /* Medidor: em fluxo (contribui para o max-content) mas sem altura nem pintura. */
  .cert-groups-sizer {
    visibility: hidden;
    height: 0;
    overflow: hidden;
  }
  .cert-groups-sizer .cert-group {
    /* Sizes to its own (always-open) content, so it drives o max-content do container. */
    width: max-content;
  }

  /* Telas estreitas: volta à largura total com quebra natural, sem overflow. */
  @media (max-width: 640px) {
    .cert-groups {
      width: auto;
    }
    .cert-groups-sizer {
      display: none;
    }
    .cert-group-summary,
    .cert-name {
      white-space: normal;
    }
    .cert-item {
      flex-wrap: wrap;
    }
  }
</style>
