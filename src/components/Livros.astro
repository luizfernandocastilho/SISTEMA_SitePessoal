---
import { withBase } from '../lib/paths';
import { t, type Locale } from '../lib/i18n';
import DownloadGate from './DownloadGate.astro';

interface Livro {
  title: string;
  author?: string;
  year?: number;
  publisher?: string;
  description_pt?: string;
  description_en?: string;
  cover?: string;
  url?: string;
  pdf?: string;
  gated?: boolean;
  fileId?: string;
  order?: number;
}

interface Props {
  id: string;
  locale: Locale;
  items: Livro[];
  strings: Record<string, string>;
  fallback: Record<string, string>;
}

const { id, locale, items, strings, fallback } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<section class="section" id={id} aria-labelledby={`${id}-title`}>
  <div class="container">
    <h2 id={`${id}-title`}>{t(strings, 'sectionLivros', fallback)}</h2>
    <ul class="livro-grid">
      {
        items.map((l) => {
          const description = locale === 'pt' ? l.description_pt : l.description_en;
          const meta = [l.author, l.publisher, l.year].filter(Boolean).join(' · ');
          const cover = l.cover
            ? l.cover.startsWith('http')
              ? l.cover
              : withBase(l.cover, base)
            : null;
          const coverEl = (
            <span class="livro-cover">
              {cover ? (
                <img src={cover} alt={l.title} loading="lazy" width="300" height="450" />
              ) : (
                <span class="livro-slide">
                  <span class="livro-slide-title">{l.title}</span>
                </span>
              )}
            </span>
          );
          const bodyMeta = (
            <>
              <span class="livro-title">{l.title}</span>
              {meta && <span class="livro-meta">{meta}</span>}
              {description && <span class="livro-desc">{description}</span>}
            </>
          );

          // Gated: o card não é link; o CTA abre um <details> com o formulário de
          // solicitação (nome/e-mail). Sem runtime JS (divulgação nativa).
          if (l.gated && l.fileId) {
            return (
              <li class="livro-card">
                <div>
                  {coverEl}
                  <span class="livro-body">
                    {bodyMeta}
                    <details class="livro-gate">
                      <summary
                        class="livro-action"
                        data-umami-event="download-request"
                        data-umami-event-file={l.fileId}
                      >
                        {t(strings, 'livroDownload', fallback)} →
                      </summary>
                      <DownloadGate
                        id={`gate-${l.fileId}`}
                        fileId={l.fileId}
                        locale={locale}
                        strings={strings}
                        fallback={fallback}
                      />
                    </details>
                  </span>
                </div>
              </li>
            );
          }

          const href = l.pdf ? withBase(l.pdf, base) : (l.url ?? null);
          const CardTag = href ? 'a' : 'div';
          const linkProps = href
            ? {
                href,
                target: '_blank',
                rel: 'noopener noreferrer',
                'data-umami-event': l.pdf ? 'download-pdf' : 'external-link',
                ...(l.pdf ? { 'data-umami-event-file': l.pdf } : { 'data-umami-event-to': l.url }),
              }
            : {};
          return (
            <li class="livro-card">
              <CardTag {...linkProps}>
                {coverEl}
                <span class="livro-body">
                  {bodyMeta}
                  {href && <span class="livro-action">{t(strings, 'livroView', fallback)} →</span>}
                </span>
              </CardTag>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  .livro-grid {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1.25rem;
  }
  .livro-card a,
  .livro-card div {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: var(--color-text);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    overflow: hidden;
    height: 100%;
  }
  .livro-card a:hover {
    border-color: var(--color-accent);
  }
  .livro-cover {
    display: block;
    flex-shrink: 0;
    min-height: 0;
    aspect-ratio: 3 / 4;
  }
  .livro-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .livro-slide {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    width: 100%;
    height: 100%;
    padding: 1rem 1.1rem;
    background: var(--color-accent);
    color: var(--color-accent-contrast);
    border-top: 3px solid var(--color-accent-vivid, #4fb055);
  }
  .livro-slide-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.2rem;
    line-height: 1.15;
  }
  .livro-body {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    padding: 0.85rem 1rem 1rem;
  }
  .livro-title {
    display: block;
    font-weight: 600;
    line-height: 1.35;
  }
  .livro-meta {
    display: block;
    margin-top: 0.2rem;
    color: var(--color-muted);
    font-size: 0.9rem;
  }
  .livro-desc {
    display: block;
    margin-top: 0.4rem;
    color: var(--color-muted);
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .livro-action {
    display: block;
    margin-top: auto;
    padding-top: 0.5rem;
    color: var(--color-accent);
    font-weight: 600;
    font-size: 0.95rem;
  }
  /* Card gated: empurra o bloco do CTA (<details>) para o rodapé, como nos demais. */
  .livro-gate {
    margin-top: auto;
  }
  /* Gate: CTA nativo (<summary>) que expande o formulário. */
  summary.livro-action {
    margin-top: 0;
    cursor: pointer;
    list-style: none;
  }
  summary.livro-action::-webkit-details-marker {
    display: none;
  }
  summary.livro-action:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 2px;
  }
</style>
