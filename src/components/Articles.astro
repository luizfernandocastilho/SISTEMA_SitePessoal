---
import { t, type Locale } from '../lib/i18n';
import DownloadRequestForm from './DownloadRequestForm.astro';

interface Article {
  title_pt: string;
  title_en: string;
  publishedAt: Date;
  venue: string;
  fileId: string;
  order?: number;
}

interface Props {
  id: string;
  locale: Locale;
  items: Article[];
  strings: Record<string, string>;
  fallback: Record<string, string>;
}

const { id, locale, items, strings, fallback } = Astro.props;

const dateFmt = new Intl.DateTimeFormat(locale === 'pt' ? 'pt-BR' : 'en-US', {
  year: 'numeric',
  month: 'long',
});
---

<section class="section" id={id} aria-labelledby={`${id}-title`}>
  <div class="container">
    <h2 id={`${id}-title`}>{t(strings, 'sectionArticles', fallback)}</h2>
    <ul class="article-list">
      {
        items.map((a) => {
          const title = locale === 'pt' ? a.title_pt : a.title_en;
          return (
            <li class="article-item">
              <p class="article-title">{title}</p>
              <p class="article-meta">
                {a.venue} · {dateFmt.format(a.publishedAt)}
              </p>
              <DownloadRequestForm
                fileId={a.fileId}
                fileTitle={title}
                locale={locale}
                strings={strings}
                fallback={fallback}
              />
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  .article-list {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
    display: grid;
    gap: 0.75rem;
  }
  .article-item {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 1rem 1.25rem;
  }
  .article-title {
    font-weight: 600;
    margin: 0;
  }
  .article-meta {
    margin: 0.15rem 0 0.6rem;
    color: var(--color-muted);
    font-size: 0.95rem;
  }
</style>
