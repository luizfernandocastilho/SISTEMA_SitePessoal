---
import { withBase } from '../lib/paths';
import { t, type Locale } from '../lib/i18n';
import DownloadGate from './DownloadGate.astro';

interface Article {
  title_pt: string;
  title_en: string;
  publishedAt: Date;
  venue: string;
  pdf?: string;
  order?: number;
  gated?: boolean;
  fileId?: string;
}

interface Props {
  id: string;
  locale: Locale;
  items: Article[];
  strings: Record<string, string>;
  fallback: Record<string, string>;
}

const { id, locale, items, strings, fallback } = Astro.props;
const base = import.meta.env.BASE_URL;

const dateFmt = new Intl.DateTimeFormat(locale === 'pt' ? 'pt-BR' : 'en-US', {
  year: 'numeric',
  month: 'long',
});
---

<section class="section" id={id} aria-labelledby={`${id}-title`}>
  <div class="container">
    <h2 id={`${id}-title`}>{t(strings, 'sectionArticles', fallback)}</h2>
    <ul class="article-list">
      {
        items.map((a) => (
          <li class="article-item">
            <div>
              <p class="article-title">{locale === 'pt' ? a.title_pt : a.title_en}</p>
              <p class="article-meta">
                {a.venue} · {dateFmt.format(a.publishedAt)}
              </p>
            </div>
            {a.gated && a.fileId ? (
              <details class="item-gate">
                <summary class="article-download item-summary">
                  {t(strings, 'articleDownload', fallback)}
                </summary>
                <DownloadGate
                  id={`gate-${a.fileId}`}
                  fileId={a.fileId}
                  locale={locale}
                  strings={strings}
                  fallback={fallback}
                />
              </details>
            ) : (
              <a
                class="article-download"
                href={withBase(a.pdf!, base)}
                download
                target="_blank"
                rel="noopener noreferrer"
              >
                {t(strings, 'articleDownload', fallback)}
              </a>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* Largura mínima e uniforme (padrão das Certificações): a lista encolhe para a
     maior linha do conteúdo (max-content) sem estourar o .container; todos os
     blocos herdam essa largura via width:100%. Alinhada à esquerda. Ver #98. */
  .article-list {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
    display: grid;
    justify-items: start;
    width: max-content;
    max-width: 100%;
    gap: 0.75rem;
  }
  .article-item {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    /* wrap mantido para o gate aberto (flex-basis:100%) descer para a própria linha. */
    flex-wrap: wrap;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 1rem 1.25rem;
  }
  .article-title {
    font-weight: 600;
    margin: 0;
    white-space: nowrap;
  }
  .article-meta {
    margin: 0.15rem 0 0;
    color: var(--color-muted);
    font-size: 0.95rem;
  }
  .article-download {
    white-space: nowrap;
    font-weight: 600;
  }
  /* Gate: CTA nativo (<summary>) que expande o formulário em largura total. */
  .item-gate {
    color: var(--color-accent);
  }
  summary.item-summary {
    cursor: pointer;
    list-style: none;
    color: var(--color-accent);
  }
  summary.item-summary::-webkit-details-marker {
    display: none;
  }
  summary.item-summary:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 2px;
  }
  .item-gate[open] {
    flex-basis: 100%;
  }

  /* Telas estreitas: volta à largura total com quebra natural, sem overflow. */
  @media (max-width: 640px) {
    .article-list {
      width: auto;
    }
    .article-title {
      white-space: normal;
    }
  }
</style>
