---
import LanguageToggle from './LanguageToggle.astro';
import type { Locale } from '../lib/i18n';
import { t } from '../lib/i18n';
import { NAV_ITEMS, NAV_CHILDREN, navUrl, navChildUrl, atuacaoAreaUrl } from '../lib/nav';
import { getAtuacao } from '../lib/content';

interface Props {
  locale: Locale;
  strings: Record<string, string>;
  fallback: Record<string, string>;
  navKey: string;
  atuacaoSlug?: string;
  counterpartHref?: string;
}

const { locale, strings, fallback, navKey, atuacaoSlug, counterpartHref } = Astro.props;
const homeUrl = navUrl(NAV_ITEMS[0], locale);
const navLabel = locale === 'pt' ? 'Navegação principal' : 'Main navigation';
// Áreas de Atuação para o dropdown do menu.
const atuacaoAreas = await getAtuacao();
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={homeUrl} aria-label="Luiz Castilho">◆</a>
    <nav aria-label={navLabel} class="nav">
      {
        NAV_ITEMS.map((item) => {
          const isCurrent = item.key === navKey ? 'page' : undefined;
          // Atuação: dropdown gerado da collection `atuacao`.
          if (item.key === 'atuacao') {
            return (
              <div class="nav-item nav-has-dropdown">
                <a href={navUrl(item, locale)} aria-current={isCurrent}>
                  {t(strings, item.labelKey, fallback)}
                </a>
                <ul class="nav-dropdown">
                  {atuacaoAreas.map((a) => (
                    <li>
                      <a href={atuacaoAreaUrl(locale, a.slug)}>
                        {locale === 'pt' ? a.title_pt : a.title_en}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            );
          }
          // Demais itens com sub-páginas estáticas (ex.: Recursos → NAV_CHILDREN).
          const children = NAV_CHILDREN[item.key];
          if (children?.length) {
            return (
              <div class="nav-item nav-has-dropdown">
                <a href={navUrl(item, locale)} aria-current={isCurrent}>
                  {t(strings, item.labelKey, fallback)}
                </a>
                <ul class="nav-dropdown">
                  {children.map((c) => (
                    <li>
                      <a href={navChildUrl(item, c, locale)}>{t(strings, c.labelKey, fallback)}</a>
                    </li>
                  ))}
                </ul>
              </div>
            );
          }
          return (
            <a href={navUrl(item, locale)} aria-current={isCurrent}>
              {t(strings, item.labelKey, fallback)}
            </a>
          );
        })
      }
    </nav>
    <LanguageToggle
      locale={locale}
      strings={strings}
      fallback={fallback}
      navKey={navKey}
      atuacaoSlug={atuacaoSlug}
      counterpartHref={counterpartHref}
    />
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--color-bg) 88%, transparent);
    backdrop-filter: saturate(1.2) blur(6px);
    border-bottom: 1px solid var(--color-border);
  }
  .header-inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-block: 0.6rem;
  }
  .brand {
    font-weight: 700;
    text-decoration: none;
    color: var(--color-accent);
    font-size: 1.1rem;
  }
  .nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 1rem;
    margin-inline-start: auto;
  }
  .nav a {
    text-decoration: none;
    color: var(--color-muted);
    font-size: 0.95rem;
    padding-block: 0.15rem;
  }
  .nav a:hover {
    color: var(--color-text);
  }
  .nav a[aria-current='page'] {
    color: var(--color-text);
    font-weight: 600;
    box-shadow: inset 0 -2px 0 var(--color-accent);
  }

  /* Item com dropdown (Atuação). Abre no hover e no foco por teclado (focus-within),
     sem runtime JS. */
  .nav-item {
    position: relative;
    display: inline-flex;
  }
  .nav-dropdown {
    position: absolute;
    top: 100%;
    inset-inline-start: 0;
    z-index: 60;
    margin: 0;
    padding: 0.35rem 0;
    list-style: none;
    min-width: 15rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    box-shadow: 0 8px 24px rgb(0 0 0 / 8%);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px);
    transition:
      opacity 0.15s ease,
      transform 0.15s ease;
  }
  .nav-has-dropdown:hover .nav-dropdown,
  .nav-has-dropdown:focus-within .nav-dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  .nav-dropdown li {
    margin: 0;
  }
  .nav-dropdown a {
    display: block;
    padding: 0.4rem 1rem;
    white-space: nowrap;
    color: var(--color-text);
  }
  .nav-dropdown a:hover {
    background: var(--color-surface);
    color: var(--color-text);
  }
  @media (prefers-reduced-motion: reduce) {
    .nav-dropdown {
      transition: none;
    }
  }

  .lang-toggle,
  .site-header :global(.lang-toggle) {
    margin-inline-start: 0.5rem;
  }
  @media (max-width: 40rem) {
    .header-inner {
      flex-wrap: wrap;
    }
    .nav {
      order: 3;
      width: 100%;
      margin-inline-start: 0;
    }
    /* Em telas estreitas o dropdown vira uma lista estática indentada (sem hover). */
    .nav-item {
      display: block;
      width: 100%;
    }
    .nav-dropdown {
      position: static;
      opacity: 1;
      visibility: visible;
      transform: none;
      min-width: 0;
      padding: 0.15rem 0 0.35rem;
      border: 0;
      box-shadow: none;
      background: transparent;
    }
    .nav-dropdown a {
      padding: 0.25rem 0 0.25rem 1rem;
      color: var(--color-muted);
    }
  }
</style>
