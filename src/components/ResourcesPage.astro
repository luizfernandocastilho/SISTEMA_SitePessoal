---
import BaseLayout from '../layouts/BaseLayout.astro';
import ResourcesDecks from './ResourcesDecks.astro';
import { getUi, getProfile } from '../lib/content';
import { t, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { strings, fallback } = await getUi(locale);
const profile = await getProfile();

const section = t(strings, 'sectionResources', fallback);
const title = `${section} · ${profile?.name ?? 'Site Pessoal'}`;
---

<BaseLayout
  locale={locale}
  title={title}
  description={section}
  strings={strings}
  fallback={fallback}
  navKey="resources"
>
  <ResourcesDecks id="resources" locale={locale} strings={strings} fallback={fallback} />
</BaseLayout>
