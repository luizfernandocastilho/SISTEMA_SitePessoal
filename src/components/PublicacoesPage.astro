---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionDecks from './SectionDecks.astro';
import { getUi, getProfile } from '../lib/content';
import { t, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { strings, fallback } = await getUi(locale);
const profile = await getProfile();

const section = t(strings, 'sectionPublicacoes', fallback);
const title = `${section} · ${profile?.name ?? 'Site Pessoal'}`;
---

<BaseLayout
  locale={locale}
  title={title}
  description={section}
  strings={strings}
  fallback={fallback}
  navKey="publications"
>
  <SectionDecks
    id="publications"
    locale={locale}
    strings={strings}
    fallback={fallback}
    parentKey="publications"
    sectionLabelKey="sectionPublicacoes"
  />
</BaseLayout>
