---
import { t, type Locale } from '../lib/i18n';
import { apiRequestUrl } from '../lib/api';
import { withBase } from '../lib/paths';

interface Props {
  fileId: string;
  fileTitle: string;
  locale: Locale;
  strings: Record<string, string>;
  fallback: Record<string, string>;
}

const { fileId, fileTitle, locale, strings, fallback } = Astro.props;
const action = apiRequestUrl();
const base = import.meta.env.BASE_URL;
const privacyHref = withBase(locale === 'pt' ? '/pt/privacidade' : '/en/privacy', base);
---

<details class="dl-form">
  <summary>{t(strings, 'downloadRequest', fallback)}</summary>
  <form method="post" action={action}>
    <input type="hidden" name="file_id" value={fileId} />
    <input type="hidden" name="file_title" value={fileTitle} />
    <input type="hidden" name="locale" value={locale} />
    <label class="dl-field">
      <span>{t(strings, 'formName', fallback)}</span>
      <input type="text" name="name" required minlength="2" autocomplete="name" />
    </label>
    <label class="dl-field">
      <span>{t(strings, 'formEmail', fallback)}</span>
      <input type="email" name="email" required autocomplete="email" />
    </label>
    <label class="dl-consent">
      <input type="checkbox" name="consent" value="on" required />
      <span>
        {t(strings, 'formConsent', fallback)}
        <a href={privacyHref}>{t(strings, 'privacyTitle', fallback)}</a>.
      </span>
    </label>
    <button type="submit" class="btn">{t(strings, 'formSubmit', fallback)}</button>
  </form>
</details>

<style>
  .dl-form {
    margin-top: 0.25rem;
  }
  .dl-form > summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--color-accent);
    width: fit-content;
  }
  .dl-form[open] > summary {
    margin-bottom: 0.75rem;
  }
  form {
    display: grid;
    gap: 0.6rem;
    max-width: 26rem;
  }
  .dl-field {
    display: grid;
    gap: 0.2rem;
  }
  .dl-field span {
    font-size: 0.9rem;
    color: var(--color-muted);
  }
  input[type='text'],
  input[type='email'] {
    font: inherit;
    padding: 0.5rem 0.6rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-bg);
    color: var(--color-text);
  }
  .dl-consent {
    display: flex;
    gap: 0.5rem;
    align-items: flex-start;
    font-size: 0.9rem;
    color: var(--color-muted);
  }
  .dl-consent input {
    margin-top: 0.25rem;
  }
  .btn {
    justify-self: start;
    display: inline-block;
    background: var(--color-accent);
    color: var(--color-accent-contrast);
    padding: 0.5rem 1rem;
    border: 0;
    border-radius: var(--radius);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }
  .btn:hover {
    filter: brightness(1.06);
  }
</style>
