---
import { withBase } from '../lib/paths';
import { t, type Locale } from '../lib/i18n';
import DownloadGate from './DownloadGate.astro';

interface Resource {
  title_pt: string;
  title_en: string;
  description_pt?: string;
  description_en?: string;
  url?: string;
  pdf?: string;
  order?: number;
  gated?: boolean;
  fileId?: string;
}

interface Props {
  id: string;
  locale: Locale;
  items: Resource[];
  strings: Record<string, string>;
  fallback: Record<string, string>;
}

const { id, locale, items, strings, fallback } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<section class="section" id={id} aria-labelledby={`${id}-title`}>
  <div class="container">
    <h2 id={`${id}-title`}>{t(strings, 'sectionResources', fallback)}</h2>
    <ul class="resource-list">
      {
        items.map((r) => {
          const title = locale === 'pt' ? r.title_pt : r.title_en;
          const description = locale === 'pt' ? r.description_pt : r.description_en;
          return (
            <li class="resource-item">
              <div>
                <p class="resource-title">{title}</p>
                {description && <p class="resource-meta">{description}</p>}
              </div>
              {r.gated && r.fileId ? (
                <details class="item-gate">
                  <summary class="resource-action item-summary">
                    {t(strings, 'resourceDownload', fallback)}
                  </summary>
                  <DownloadGate
                    id={`gate-${r.fileId}`}
                    fileId={r.fileId}
                    locale={locale}
                    strings={strings}
                    fallback={fallback}
                  />
                </details>
              ) : (
                <a
                  class="resource-action"
                  href={r.pdf ? withBase(r.pdf, base) : r.url!}
                  target="_blank"
                  rel="noopener noreferrer"
                  {...(r.pdf ? { download: true } : {})}
                >
                  {r.pdf
                    ? t(strings, 'resourceDownload', fallback)
                    : t(strings, 'resourceOpen', fallback)}
                </a>
              )}
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  .resource-list {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
    display: grid;
    gap: 0.75rem;
  }
  .resource-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 1rem 1.25rem;
  }
  .resource-title {
    font-weight: 600;
    margin: 0;
  }
  .resource-meta {
    margin: 0.15rem 0 0;
    color: var(--color-muted);
    font-size: 0.95rem;
    max-width: 60ch;
  }
  .resource-action {
    white-space: nowrap;
    font-weight: 600;
  }
  /* Gate: CTA nativo (<summary>) que expande o formulário em largura total. */
  summary.item-summary {
    cursor: pointer;
    list-style: none;
    color: var(--color-accent);
  }
  summary.item-summary::-webkit-details-marker {
    display: none;
  }
  summary.item-summary:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 2px;
  }
  .item-gate[open] {
    flex-basis: 100%;
  }
</style>
