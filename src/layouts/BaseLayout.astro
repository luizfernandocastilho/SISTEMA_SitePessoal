---
import '../styles/global.css';
import Header from '../components/Header.astro';
import type { Locale } from '../lib/i18n';
import { t } from '../lib/i18n';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  strings: Record<string, string>;
  fallback: Record<string, string>;
  navKey: string;
  atuacaoSlug?: string;
  counterpartHref?: string;
}

const { locale, title, description, strings, fallback, navKey, atuacaoSlug, counterpartHref } =
  Astro.props;
const year = new Date().getFullYear();

// Analytics Umami (self-hosted). O snippet só é injetado quando AMBAS as envs
// existem (build de produção); ausentes (ex.: `npm run dev`, PRs) = sem tracking.
const umamiSrc = import.meta.env.PUBLIC_UMAMI_SRC;
const umamiWebsiteId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href="/fonts/oswald-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link
      rel="preload"
      href="/fonts/source-sans-3-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {
      umamiSrc && umamiWebsiteId && (
        <script is:inline defer src={umamiSrc} data-website-id={umamiWebsiteId} />
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">{t(strings, 'skipToContent', fallback)}</a>
    <Header
      locale={locale}
      strings={strings}
      fallback={fallback}
      navKey={navKey}
      atuacaoSlug={atuacaoSlug}
      counterpartHref={counterpartHref}
    />
    <main id="main">
      <slot />
    </main>
    <footer class="section">
      <div class="container">
        <p style="color: var(--color-muted); margin: 0;">
          © {year} · {t(strings, 'footerRights', fallback)}
        </p>
      </div>
    </footer>
  </body>
</html>
